# Master API Key (Super Admin override key)
API_KEY=master_secret_token_12345

# MongoDB Connection URL (Required for dynamic API keys and statistics)
MONGO_URL=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=anonx_stream_api

# Telegram Bot Token from @BotFather (Required to enable key generation via Telegram)
BOT_TOKEN=1234567890:ABCdefGhIjKlMnOpQrStUvWxYz
OWNER_ID=8900240311

# Your public Railway domain (Shown to users when they generate a key)
PUBLIC_URL=https://your-app-name.up.railway.app

# URL to automatically fetch fresh cookies on startup (e.g. from batbin.me/raw/<id>)
COOKIES_URL=https://batbin.me/raw/deejay

# Port (Railway automatically injects $PORT)
PORT=8000
